# NYAYAAI Environment Configuration
# Free-Tier AI & Zero-Paid Services Architecture

# Google Gemini API Key (Free tier: https://aistudio.google.com/)
# If missing, NyayaAI automatically operates in Mock AI Mode with full realistic data.
GEMINI_API_KEY=

# Set to true to force Mock AI mode even if GEMINI_API_KEY is provided
MOCK_AI=false

# Port for Backend Server
PORT=5000

# MongoDB URI
# If MongoDB is unavailable or not running, NyayaAI automatically falls back to an offline local JSON database!
MONGODB_URI=mongodb://localhost:27017/nyayaai

# Client URL for CORS
CLIENT_URL=http://localhost:5173
