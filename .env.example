# NYAYAAI Environment Configuration
# Free-Tier AI & Zero-Paid Services Architecture

# ─────────────────────────────────────────────────────────────────
# REQUIRED FOR AI FEATURES
# Get your free key at: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# Set to true to force Mock AI mode even if GEMINI_API_KEY is provided
MOCK_AI=false

# ─────────────────────────────────────────────────────────────────
# DATABASE (optional — app works without it using in-memory store)
# For Vercel: use MongoDB Atlas free tier (https://cloud.mongodb.com)
# ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/nyayaai

# ─────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT ONLY
# ─────────────────────────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────
# VERCEL DEPLOYMENT
# Set these in: Vercel Dashboard → Project → Settings → Environment Variables
#   GEMINI_API_KEY   → your Google Gemini API key
#   MONGODB_URI      → your MongoDB Atlas connection string (optional)
# No other env vars are required for Vercel deployment.
# ─────────────────────────────────────────────────────────────────
